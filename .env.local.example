# Локальний кабінет відкривається лише на цьому ПК: http://localhost:4000/factory
PORT=4000

# Тимчасово залишаємо наявні Neon і R2. Скопіюй значення з Render → Environment.
DATABASE_URL=
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Генерація назв, текстів і образів.
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-5.6-luna
OPENAI_IMAGE_MODEL=gpt-image-2.5-flare

# YouTube. Наявний refresh token лишається зашифрованим у Neon.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_SETUP_SECRET=
YOUTUBE_CHANNEL_ID=UCf6q4aVKDAs6lxDzp-dzJEg

# auto спершу перевіряє NVIDIA NVENC і безпечно переходить на процесор, якщо він недоступний.
LOCAL_VIDEO_ENCODER=auto
MEDIA_THREADS=8

# Необов'язковий резервний генератор Cloudflare.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_AI_TOKEN=
