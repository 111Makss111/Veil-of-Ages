VEIL_API_URL=https://veil-of-ages.onrender.com
# Use the same random 32+ character value in Render and on this PC.
LOCAL_WORKER_SECRET=
# Needed locally only for matching lyric phrases to the vocal.
OPENAI_API_KEY=
# "auto" uses NVIDIA NVENC when the installed driver supports this FFmpeg build,
# otherwise it safely falls back to the CPU encoder.
LOCAL_VIDEO_ENCODER=auto
MEDIA_THREADS=8
