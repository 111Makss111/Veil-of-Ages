PORT=4000
DATABASE_URL=postgresql://user:password@host/database?sslmode=require
WEB_ORIGIN=http://localhost:3000
PUBLIC_API_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
LINK_TTL_MINUTES=10
# YouTube OAuth: Render only. Generate a random secret (32+ characters).
# Keep this secret stable: it encrypts the refresh token in Neon.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_SETUP_SECRET=
# Owner login + Authenticator encryption. Render only, random 32+ characters.
# Keep stable and back up securely; changing it makes the enrolled MFA unreadable.
AUTH_SECRET=
# Optional separate Google OAuth client; defaults to YOUTUBE_CLIENT_ID/SECRET.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Factory: private Standard R2 bucket. Server only; never NEXT_PUBLIC_.
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Primary AI provider for song packages and automatic images. Server only.
OPENAI_API_KEY=
# Optional overrides; normally leave these defaults unchanged.
OPENAI_TEXT_MODEL=gpt-5.6-luna
OPENAI_IMAGE_MODEL=gpt-image-2.5-flare
# Separate Cloudflare profile token for Workers AI. Do not reuse the R2 S3 secret.
# Used as a fallback when OpenAI has a temporary outage. Account ID defaults to
# R2_ACCOUNT_ID when both Cloudflare services use the same account.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_AI_TOKEN=
