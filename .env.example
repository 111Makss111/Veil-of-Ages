PORT=4000
DATABASE_URL=postgresql://user:password@host/database?sslmode=require
WEB_ORIGIN=http://localhost:3000
PUBLIC_API_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
LINK_TTL_MINUTES=10
# YouTube OAuth: Render only. Generate a random secret (32+ characters).
# Keep this secret stable: it encrypts the refresh token in Neon.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_SETUP_SECRET=
# Owner login + Authenticator encryption. Render only, random 32+ characters.
# Keep stable and back up securely; changing it makes the enrolled MFA unreadable.
AUTH_SECRET=
# Optional separate Google OAuth client; defaults to YOUTUBE_CLIENT_ID/SECRET.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
